{
  "name": "server",
  "version": "2.0.0",
  "author": "Om Patel",
  "description": "TypeScript Express API for the MERN Dashboard",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx src/data/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "country-iso-2-to-3": "^1.1.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "lodash": "^4.17.21",
    "mongoose": "^9.8.1",
    "morgan": "^1.11.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.7",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "mongodb-memory-server": "^10.0.0",
    "oxlint": "^1.76.0",
    "supertest": "^7.0.0",
    "tsx": "^4.16.0",
    "typescript": "^7.0.2",
    "vitest": "^2.0.0"
  }
}
